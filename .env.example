# Copie para .env e preencha. Nunca versione o .env.

# OpenAI
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
GUARDRAIL_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=30

# Banco (Postgres 16 + pgvector) — checkpoints, thread_metadata e vetores
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financial_agent

# RAG
RAG_MIN_SCORE=0.35
RAG_TOP_K=4

# Cotação de moedas (AwesomeAPI)
FX_API_BASE_URL=https://economia.awesomeapi.com.br
FX_TIMEOUT_SECONDS=5

# Retenção de conversas (dias)
THREAD_RETENTION_DAYS=30

# Chaves de acesso da API, separadas por vírgula. Vazio = autenticação desativada.
API_KEYS=

# Chave usada pelo front (serviço web) para falar com a API; deve ser uma das API_KEYS. Nunca vai ao navegador.
FINAGENT_API_KEY=

LOG_LEVEL=INFO
